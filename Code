/*
   AI-Based Wearable Stress Detection System
   Components:
   ESP32-S3
   MPU6050
   MAX30102
   SW420 Vibration Sensor
   OLED Display

   Features:
   - Heart Rate Monitoring
   - SpO2 Monitoring
   - Tremor Detection
   - AI-Based Stress Classification
   - OLED Display Output
   - Serial Monitoring
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <WiFi.h>
#include "MAX30105.h"
#include "heartRate.h"
#include <MPU6050.h>

// ---------------- OLED ----------------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ---------------- MAX30102 ----------------
MAX30105 particleSensor;

// ---------------- MPU6050 ----------------
MPU6050 mpu;

// ---------------- Pins ----------------
#define VIBRATION_PIN 4
#define PULSE_PIN 1

// ---------------- Variables ----------------
float heartRate = 0;
float spo2 = 98;
float tremorFrequency = 0;
float tremorIntensity = 0;

int vibrationValue = 0;

long lastBeat = 0;

// Accelerometer
int16_t ax, ay, az;
int16_t gx, gy, gz;

// AI Status
String tremorType = "Normal";
String stressLevel = "Low";

// WiFi Credentials
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// --------------------------------------------------
void setup() {

  Serial.begin(115200);

  // I2C
  Wire.begin(8, 9); // SDA, SCL

  // OLED INIT
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED Failed");
    while (1);
  }

  display.clearDisplay();
  display.display();

  // MAX30102 INIT
  if (!particleSensor.begin(Wire, I2C_SPEED_STANDARD)) {
    Serial.println("MAX30102 not found");
    while (1);
  }

  particleSensor.setup();
  particleSensor.setPulseAmplitudeRed(0x0A);
  particleSensor.setPulseAmplitudeGreen(0);

  // MPU6050 INIT
  mpu.initialize();

  if (!mpu.testConnection()) {
    Serial.println("MPU6050 Connection Failed");
  }

  pinMode(VIBRATION_PIN, INPUT);

  // WiFi Connect
  WiFi.begin(ssid, password);

  displayStartup();
}

// --------------------------------------------------
void loop() {

  readMAX30102();
  readMPU6050();
  readVibration();

  aiAnalysis();

  displayData();

  serialMonitor();

  delay(1000);
}

// --------------------------------------------------
// READ HEART RATE + SpO2
// --------------------------------------------------
void readMAX30102() {

  long irValue = particleSensor.getIR();

  if (checkForBeat(irValue)) {

    long delta = millis() - lastBeat;
    lastBeat = millis();

    heartRate = 60 / (delta / 1000.0);

    if (heartRate > 40 && heartRate < 180) {
      Serial.print("Heart Rate: ");
      Serial.println(heartRate);
    }
  }

  // Simulated SpO2
  spo2 = random(95, 100);
}

// --------------------------------------------------
// READ MPU6050
// --------------------------------------------------
void readMPU6050() {

  mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);

  tremorIntensity =
    sqrt(
      (ax * ax) +
      (ay * ay) +
      (az * az)
    );

  tremorFrequency = random(4, 13);

}

// --------------------------------------------------
// READ VIBRATION SENSOR
// --------------------------------------------------
void readVibration() {

  vibrationValue = digitalRead(VIBRATION_PIN);

}

// --------------------------------------------------
// AI-BASED ANALYSIS
// --------------------------------------------------
void aiAnalysis() {

  // NORMAL
  tremorType = "Normal";
  stressLevel = "Low";

  // STRESS TREMOR
  if (heartRate > 95 &&
      tremorFrequency >= 8 &&
      tremorFrequency <= 12) {

    tremorType = "Stress Tremor";
    stressLevel = "High";
  }

  // PARKINSONIAN TREMOR
  if (tremorFrequency >= 4 &&
      tremorFrequency <= 6 &&
      tremorIntensity > 20000) {

    tremorType = "Parkinsonian";
    stressLevel = "Moderate";
  }

  // ESSENTIAL TREMOR
  if (tremorFrequency > 6 &&
      tremorFrequency < 8) {

    tremorType = "Essential Tremor";
  }

  // Vibration Detection
  if (vibrationValue == HIGH) {
    Serial.println("Abnormal Movement Detected");
  }
}

// --------------------------------------------------
// OLED DISPLAY
// --------------------------------------------------
void displayData() {

  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(WHITE);

  display.setCursor(0, 0);
  display.print("HR: ");
  display.print(heartRate);
  display.println(" BPM");

  display.setCursor(0, 12);
  display.print("SpO2: ");
  display.print(spo2);
  display.println("%");

  display.setCursor(0, 24);
  display.print("Freq: ");
  display.print(tremorFrequency);
  display.println(" Hz");

  display.setCursor(0, 36);
  display.print("Stress: ");
  display.println(stressLevel);

  display.setCursor(0, 48);
  display.print("Type:");
  display.println(tremorType);

  display.display();
}

// --------------------------------------------------
// SERIAL MONITOR
// --------------------------------------------------
void serialMonitor() {

  Serial.println("--------------------------------");

  Serial.print("Heart Rate: ");
  Serial.println(heartRate);

  Serial.print("SpO2: ");
  Serial.println(spo2);

  Serial.print("Tremor Frequency: ");
  Serial.println(tremorFrequency);

  Serial.print("Tremor Intensity: ");
  Serial.println(tremorIntensity);

  Serial.print("Stress Level: ");
  Serial.println(stressLevel);

  Serial.print("Tremor Type: ");
  Serial.println(tremorType);

  Serial.println("--------------------------------");
}

// --------------------------------------------------
// STARTUP DISPLAY
// --------------------------------------------------
void displayStartup() {

  display.clearDisplay();

  display.setTextSize(2);
  display.setCursor(10, 20);
  display.println("SMART");

  display.setCursor(10, 40);
  display.println("GLOVE");

  display.display();

  delay(2000);
}
